      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Service reports healthy\", () => pm.expect(pm.response.json().status).to.eql(\"healthy\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "02. Register Player A (200)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString().slice(-8);",
              "pm.collectionVariables.set(\"username\", \"faf_survivor_\" + suffix);",
              "pm.collectionVariables.set(\"usernameB\", \"faf_trader_\" + suffix);",
              "pm.collectionVariables.set(\"idempotencyKey\", \"trade_\" + suffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Returns player_id and jwt\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"player_id\");",
              "    pm.expect(body).to.have.property(\"jwt\");",
              "    pm.collectionVariables.set(\"playerId\", body.player_id);",
              "    pm.collectionVariables.set(\"jwt\", body.jwt);",
              "});",
              "pm.test(\"player_id uses the contract prefix\", () => pm.expect(pm.response.json().player_id).to.match(/^p_/));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"hunter2pass\",\n  \"email\": \"student@faf.md\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
