      "item": [
        {
          "name": "1. Create Room - Success (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has generated roomName\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"roomName\");",
                  "    pm.collectionVariables.set(\"roomName\", jsonData.roomName);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomName\": \"physicsLaboratoryA\",\n  \"fullRoomName\": \"Physics Laboratory A\",\n  \"type\": \"laboratory\",\n  \"resourceType\": \"metal scraps\",\n  \"zoneName\": \"mainCorridorZone\",\n  \"connectsTo\": [\"hallway-101\", \"storage-room\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rooms"
              ]
            },
            "description": "Creates a new room. Saves roomName to collection variables."
