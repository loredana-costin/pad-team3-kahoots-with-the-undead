      "name": "Monitoring",
      "description": "GET /metrics of zombie-service (Prometheus text format), the endpoint Prometheus scrapes for the Grafana dashboard.",
      "item": [
        {
          "name": "Metrics (GET /metrics through the Message Broker)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Mint a service token for game-service, which the message broker requires (it calls this route in the system).",
                  "// HS256, issuer player-service, audience kahoots-with-the-undead, kind service, signed with jwtSecret.",
                  "const b64url = (wordArray) => CryptoJS.enc.Base64.stringify(wordArray).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const encode = (obj) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(obj)));",
                  "const now = Math.floor(Date.now() / 1000);",
                  "const header = encode({ alg: 'HS256', typ: 'JWT' });",
                  "const payload = encode({ sub: 'game-service', kind: 'service', iss: 'player-service', aud: 'kahoots-with-the-undead', iat: now, exp: now + 3600 });",
                  "const signature = b64url(CryptoJS.HmacSHA256(header + '.' + payload, pm.collectionVariables.get('jwtSecret')));",
                  "pm.collectionVariables.set('serviceJwt', header + '.' + payload + '.' + signature);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Prometheus text format', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain');",
                  "});",
                  "const text = pm.response.text();",
                  "pm.test('HTTP metrics with the team names and labels', function () {",
                  "    pm.expect(text).to.include('# TYPE http_requests_received_total counter');",
                  "    pm.expect(text).to.include('http_requests_received_total{');",
                  "    pm.expect(text).to.include('http_request_duration_seconds_bucket{');",
                  "    pm.expect(text).to.include('http_requests_in_progress');",
                  "    pm.expect(text).to.match(/code=\"\\d{3}\",method=\"[A-Z]+\",route=\"[^\"]+\"/);",
                  "});",
                  "pm.test('The database answers', function () { pm.expect(text).to.include('kahoots_database_up 1'); });",
                  "pm.test('Circuit breaker towards Service Discovery is closed', function () {",
                  "    pm.expect(text).to.include('kahoots_circuit_breaker_open{target=\"discovery-service\"} 0');",
                  "});",
                  "pm.test('Node.js process metrics', function () { pm.expect(text).to.include('process_cpu_user_seconds_total'); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceJwt}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{brokerUrl}}/queues/zombie-service/metrics",
              "host": [
                "{{brokerUrl}}"
              ],
              "path": [
                "queues",
                "zombie-service",
                "metrics"
              ]
            },
            "description": "What Prometheus scrapes every 10 s from each replica (it reads the replicas directly on the Docker network; the team compose does not publish their ports, so the collection reaches one replica through the broker's queue)."
          },
          "response": []
