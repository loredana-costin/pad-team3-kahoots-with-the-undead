        {
          "name": "Delete Zombie Type",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types/{{typeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types",
                "{{typeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete Zombie Type - Already Deleted (404)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types/{{typeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types",
                "{{typeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
