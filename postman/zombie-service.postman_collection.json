{
  "info": {
    "name": "Zombie Service",
    "description": "In Kahoots with the Undead \u2014 Zombie Service API. Covers the CRUD endpoints over /api/zombie-types through the Gateway, the spawn / special-action endpoints Game Service calls (through the message broker, since the Gateway refuses them), and GET /metrics. Owner: Costin Loredana.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "typeId",
      "value": "prof_calc",
      "type": "string",
      "description": "Set automatically by 'Create Zombie Type' via its test script; also used as a default for read/update/delete requests."
    },
    {
      "key": "curableTypeId",
      "value": "infected_student",
      "type": "string",
      "description": "Set automatically by 'Create Curable Zombie Type' via its test script; kept separate from {{typeId}} so it doesn't interfere with the main create/update/delete flow."
    },
    {
      "key": "spawnedInstanceId",
      "value": "",
      "type": "string",
      "description": "Set automatically by 'Spawn Zombies' via its test script (first zombie in the response)."
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "username",
      "value": "",
      "type": "string"
    },
    {
      "key": "jwt",
      "value": "",
      "type": "string"
    },
    {
      "key": "brokerUrl",
      "value": "http://localhost:8600"
    },
    {
      "key": "jwtSecret",
      "value": "team-compose-development-secret-at-least-32-chars"
    },
    {
      "key": "serviceJwt",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "Register a test player (200)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A fresh player per run, so the collection can be run repeatedly against the same databases.",
              "pm.collectionVariables.set('runId', Date.now().toString(36));",
              "pm.collectionVariables.set('username', 'pm_' + pm.collectionVariables.get('runId'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Token is returned\", function () {",
              "    const json = pm.response.json();",
              "    pm.collectionVariables.set('jwt', json.jwt);",
              "    pm.expect(json.jwt).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Registers a fresh player through the Gateway; every later request sends its token as the collection's bearer auth.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"pm_{{runId}}_password\",\n  \"email\": \"{{username}}@test.local\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
