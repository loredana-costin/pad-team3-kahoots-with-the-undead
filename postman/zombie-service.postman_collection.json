{
  "info": {
    "name": "Zombie Service",
    "description": "In Kahoots with the Undead \u2014 Zombie Service API. Covers the currently implemented CRUD endpoints over /api/zombie-types. Owner: Costin Loredana.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4001",
      "type": "string"
    },
    {
      "key": "typeId",
      "value": "prof_calc",
      "type": "string",
      "description": "Set automatically by 'Create Zombie Type' via its test script; also used as a default for read/update/delete requests."
    },
    {
      "key": "curableTypeId",
      "value": "infected_student",
      "type": "string",
      "description": "Set automatically by 'Create Curable Zombie Type' via its test script; kept separate from {{typeId}} so it doesn't interfere with the main create/update/delete flow."
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Zombie Types",
      "item": [
        {
          "name": "List All Zombie Types",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List Zombie Types - Filtered by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types?category=professor",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "professor"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Every result is category=professor', function () {",
                  "  const body = pm.response.json();",
                  "  body.forEach(z => pm.expect(z.category).to.eql('professor'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List Zombie Types - Invalid Category (400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types?category=ghost",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "ghost"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Zombie Type By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types/{{typeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types",
                "{{typeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('typeId matches requested', function () {",
                  "  pm.expect(pm.response.json().typeId).to.eql(pm.collectionVariables.get('typeId'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Zombie Type By Id - Not Found (404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types/does_not_exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types",
                "does_not_exist"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Infected Zombie Type (Seeded)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types/infected_student",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types",
                "infected_student"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('category is infected', function () { pm.expect(pm.response.json().category).to.eql('infected'); });",
                  "pm.test('curable is true', function () { pm.expect(pm.response.json().curable).to.eql(true); });",
                  "pm.test('cureRequirement matches seed data', function () {",
                  "  pm.expect(pm.response.json().cureRequirement).to.eql({ resourceType: 'chemicals', amount: 2 });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List Zombie Types - Filtered by Infected Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types?category=infected",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "infected"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Every result is category=infected', function () {",
                  "  const body = pm.response.json();",
                  "  body.forEach(z => pm.expect(z.category).to.eql('infected'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create Zombie Type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"tourist\",\n  \"name\": \"Exchange Student {{$randomInt}}\",\n  \"baseHealth\": 15,\n  \"attackStrength\": 1,\n  \"moveSpeed\": 2.0,\n  \"perceptionRadius\": 8,\n  \"specialAbility\": \"steal_xp\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has a typeId', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.typeId).to.be.a('string');",
                  "  pm.collectionVariables.set('typeId', body.typeId);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create Zombie Type - Missing Fields (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"tourist\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error code is invalid_zombie_type', function () {",
                  "  pm.expect(pm.response.json().error).to.eql('invalid_zombie_type');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create Zombie Type - Duplicate Name (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"tourist\",\n  \"name\": \"Backpacker Horde\",\n  \"baseHealth\": 1,\n  \"attackStrength\": 1,\n  \"moveSpeed\": 1,\n  \"perceptionRadius\": 1,\n  \"specialAbility\": \"x\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create Curable Zombie Type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"infected\",\n  \"name\": \"Infected Lab Assistant {{$randomInt}}\",\n  \"baseHealth\": 18,\n  \"attackStrength\": 1,\n  \"moveSpeed\": 1.1,\n  \"perceptionRadius\": 6,\n  \"specialAbility\": \"seek_cure\",\n  \"curable\": true,\n  \"cureRequirement\": { \"resourceType\": \"chemicals\", \"amount\": 3 }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('curable is true and cureRequirement is echoed back', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.curable).to.eql(true);",
                  "  pm.expect(body.cureRequirement).to.eql({ resourceType: 'chemicals', amount: 3 });",
                  "  pm.collectionVariables.set('curableTypeId', body.typeId);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create Curable Zombie Type - Missing cureRequirement (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"infected\",\n  \"name\": \"Broken Infected Zombie {{$randomInt}}\",\n  \"baseHealth\": 10,\n  \"attackStrength\": 1,\n  \"moveSpeed\": 1,\n  \"perceptionRadius\": 5,\n  \"specialAbility\": \"seek_cure\",\n  \"curable\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error mentions cureRequirement', function () {",
                  "  pm.expect(pm.response.json().message).to.include('cureRequirement');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update Zombie Type",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseHealth\": 99\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types/{{typeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types",
                "{{typeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('baseHealth was updated', function () {",
                  "  pm.expect(pm.response.json().baseHealth).to.eql(99);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update Zombie Type - Not Found (404)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseHealth\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/zombie-types/does_not_exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombie-types",
                "does_not_exist"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "response": []
