    {
      "name": "Zombie Instances (Game Service routes, through the Message Broker)",
      "description": "POST /api/zombies/spawn and POST /api/zombies/{instanceId}/special-action are called by Game Service only. The Gateway refuses them (404 route_not_found), so the collection checks that, then sends them to zombie-service's queue in the message broker with a game-service token. Spawning picks real, weighted zombie types from /api/zombie-types; special actions are shaped by the instance's category and ability.",
      "item": [
        {
          "name": "Spawn Zombies through the Gateway - Internal Route (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/zombies/spawn",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "zombies",
                "spawn"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cycleId\": \"cyc_884\",\n  \"worldZoneId\": \"zone_12\",\n  \"spawnCount\": 5,\n  \"typeWeights\": {\n    \"professor\": 0.3,\n    \"tourist\": 0.7\n  }\n}"
            },
            "description": "Only Game Service calls this route, through the message broker, so the Gateway must not forward it, whatever token the request carries (Lab 4: routes that must not be user available are removed from the Gateway)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The Gateway refuses the internal route with 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('Error is route_not_found', function () {",
                  "    pm.expect(pm.response.json().error).to.eql('route_not_found');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Spawn Zombies (through the Message Broker)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{brokerUrl}}/queues/zombie-service/api/zombies/spawn",
              "host": [
                "{{brokerUrl}}"
              ],
              "path": [
                "queues",
                "zombie-service",
                "api",
                "zombies",
                "spawn"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cycleId\": \"cyc_884\",\n  \"worldZoneId\": \"zone_12\",\n  \"spawnCount\": 5,\n  \"typeWeights\": {\n    \"professor\": 0.3,\n    \"tourist\": 0.7\n  }\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceJwt}}",
                  "type": "string"
                }
              ]
            },
            "description": "The Gateway refuses this route, which only game-service calls in the system, so the collection sends it to zombie-service through the message broker's queue ({{brokerUrl}}/queues/zombie-service/...) with a game-service service token."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Returns spawnCount zombies with real type data', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.zombies).to.have.lengthOf(5);",
                  "  body.zombies.forEach(z => {",
                  "    pm.expect(z.instanceId).to.be.a('string');",
                  "    pm.expect(['professor','tourist']).to.include(z.category);",
                  "    pm.expect(z.health).to.be.a('number');",
                  "  });",
                  "  pm.collectionVariables.set('spawnedInstanceId', body.zombies[0].instanceId);",
                  "});",
                  "pm.test('Delivered by the message broker from the service queue', function () {",
                  "    pm.expect(pm.response.headers.get('X-Broker-Queue')).to.eql('zombie-service');",
                  "    pm.expect(pm.response.headers.get('X-Broker-Instance')).to.include('zombie-service');",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Mint a service token for game-service, which the message broker requires (it calls this route in the system).",
                  "// HS256, issuer player-service, audience kahoots-with-the-undead, kind service, signed with jwtSecret.",
                  "const b64url = (wordArray) => CryptoJS.enc.Base64.stringify(wordArray).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
