    {
      "name": "Resource Economy (Mocked)",
      "description": "Mocked business logic for the endpoints the CPR contract documents as consumed by Game/Base/Crafting Service (none of which exist yet). Idempotency is real: these are backed by the resource_transactions ledger table. Node data is an in-memory stand-in for the node placement World Service will eventually own. Run 'Gather - Apply' before 'Gather - Duplicate' so the idempotency key exists.",
      "item": [
        {
          "name": "Gather - Apply",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gather",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gather"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"idempotencyKey\": \"{{gatherIdempotencyKey}}\",\n    \"playerId\": \"{{playerId}}\",\n    \"nodeId\": \"{{nodeId}}\",\n    \"resourceType\": \"wood\",\n    \"amount\": 12\n  }"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate the key once here so 'Gather - Duplicate' can reuse the",
                  "// exact same literal string; {{$randomInt}} re-evaluates on every",
                  "// use, so it can't safely live inside the stored variable itself.",
                  "pm.collectionVariables.set('gatherIdempotencyKey', 'gather_p44_node1_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Status is applied', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('applied');",
                  "  pm.expect(body.newBalance).to.be.an('object');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Gather - Duplicate (Idempotent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gather",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "gather"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"idempotencyKey\": \"{{gatherIdempotencyKey}}\",\n    \"playerId\": \"{{playerId}}\",\n    \"nodeId\": \"{{nodeId}}\",\n    \"resourceType\": \"wood\",\n    \"amount\": 12\n  }"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Replays result instead of applying twice', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('already_applied');",
                  "});"
                ]
              }
            }
          ]
        },
