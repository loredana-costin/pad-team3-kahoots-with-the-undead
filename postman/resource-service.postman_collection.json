    {
      "name": "Player Inventory",
      "item": [
        {
          "name": "Create Inventory",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/inventory/{{playerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "{{playerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Use a fresh player (and fresh spend/refund keys) on every run. The gather/spend/refund",
                  "// requests later in this collection re-create the player's inventory after 'Delete Inventory',",
                  "// so a fixed playerId would make this request return 409 on the next run.",
                  "const runId = Date.now();",
                  "pm.collectionVariables.set('playerId', 'p_' + runId);",
                  "pm.collectionVariables.set('spendIdempotencyKey', 'spend_barricade_' + runId);",
                  "pm.collectionVariables.set('refundIdempotencyKey', 'refund_craft_' + runId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Resources start empty', function () {",
                  "  pm.expect(pm.response.json().resources).to.eql({});",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create Inventory - Already Exists (409)",
          "request": {
            "method": "POST",
            "url": {
