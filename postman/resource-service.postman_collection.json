{
  "info": {
    "name": "Resource Service",
    "description": "In Kahoots with the Undead \u2014 Resource Service API. Covers the implemented CRUD endpoints over /api/resource-types and /api/inventory, plus the mocked idempotent gather/spend/refund endpoints and the mocked node lookup that Game/Base/Crafting Service will call once they exist (see the CPR communication contract). Owner: Costin Loredana.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4002",
      "type": "string"
    },
    {
      "key": "resourceTypeId",
      "value": "wood",
      "type": "string",
      "description": "Set automatically by 'Create Resource Type' via its test script; also used as a default for read/update/delete requests."
    },
    {
      "key": "playerId",
      "value": "p_44",
      "type": "string",
      "description": "Set to a fresh 'p_<timestamp>' by 'Create Inventory' on every run so the collection can be re-run against the same database."
    },
    {
      "key": "spendIdempotencyKey",
      "value": "spend_p44_barricade_{{$randomInt}}",
      "type": "string",
      "description": "Set to a fresh per-run key by 'Create Inventory'."
    },
    {
      "key": "refundIdempotencyKey",
      "value": "refund_p44_craft_{{$randomInt}}",
      "type": "string",
      "description": "Set to a fresh per-run key by 'Create Inventory'."
    },
    {
      "key": "nodeId",
      "value": "node_1",
      "type": "string",
      "description": "One of the mocked nodes seeded in InMemoryNodeRepository (node_1..node_4)."
    },
    {
      "key": "gatherIdempotencyKey",
      "value": "",
      "type": "string",
      "description": "Set by 'Gather - Apply''s pre-request script to a fresh, concrete key; 'Gather - Duplicate' reuses that exact value on purpose."
    }
  ],
