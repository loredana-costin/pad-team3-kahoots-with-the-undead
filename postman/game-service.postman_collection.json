            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Action is running with a progress percent\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql(\"in_progress\");",
              "    pm.expect(body.actionType).to.eql(\"scavenge\");",
              "    pm.expect(body.percent).to.be.at.least(0).and.at.most(100);",
              "});",
              "pm.test(\"completesAt is durationSeconds after startedAt\", () => {",
              "    const body = pm.response.json();",
              "    const seconds = (new Date(body.completesAt) - new Date(body.startedAt)) / 1000;",
              "    pm.expect(Math.round(seconds)).to.eql(body.durationSeconds);",
              "});"
            ]
          }
        }
