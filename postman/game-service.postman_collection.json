    {
      "name": "01. Health Check (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Service reports healthy\", () => pm.expect(pm.response.json().status).to.eql(\"healthy\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "02. Create Session (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Opens as a lobby on day 1 with no players\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.session_id).to.match(/^session_/);",
              "    pm.expect(body.status).to.eql(\"lobby\");",
              "    pm.expect(body.cycle).to.eql(\"day\");",
              "    pm.expect(body.cycleNumber).to.eql(1);",
              "    pm.expect(body.players).to.be.an(\"array\").that.is.empty;",
              "    pm.collectionVariables.set(\"sessionId\", body.session_id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"FAF Block 1\",\n  \"zoneId\": \"zone_12\",\n  \"maxPlayers\": 4\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sessions"
          ]
        }
      }
    },
