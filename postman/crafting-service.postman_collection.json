    {
      "name": "2. Recipes for a player",
      "description": "",
      "item": [
        {
          "name": "List recipes for player",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Seeded recipes are listed with their lock state\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.playerId).to.eql(pm.collectionVariables.get('playerId'));",
                  "    const kit = json.recipes.find(r => r.recipeId === 'recipe_wood_metal');",
                  "    pm.expect(kit.unlocked).to.be.true;",
                  "    pm.expect(kit.ingredients).to.eql([{ resourceType: 'wood', amount: 3 }, { resourceType: 'metal', amount: 1 }]);",
                  "    const detector = json.recipes.find(r => r.recipeId === 'recipe_metal_electronics');",
                  "    pm.expect(detector.unlocked).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes?playerId={{playerId}}&includeLocked=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipes"
              ],
              "query": [
                {
                  "key": "playerId",
                  "value": "{{playerId}}"
                },
                {
                  "key": "includeLocked",
                  "value": "true"
                }
