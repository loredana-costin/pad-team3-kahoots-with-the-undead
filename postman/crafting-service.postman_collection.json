    "name": "Crafting Service",
    "description": "Tests for Crafting Service (In Kahoots with the Undead, Team 3). Run the folders in order. Requires the service to run with Integrations__UseMocks=true (the default), which simulates Resource, Player, Exam and World Service, and the seed data (./run.sh seeds it) for the five contract recipes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A fresh player and key prefix per run, so the collection can be run repeatedly against the same database.",
          "if (!pm.collectionVariables.get('runId')) {",
          "    pm.collectionVariables.set('runId', Date.now().toString(36));",
          "}",
          "pm.collectionVariables.set('playerId', 'pm_' + pm.collectionVariables.get('runId'));"
        ]
      }
    }
  ],
