        {
          "name": "Register a test player (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh player and key prefix per run, so the collection can be run repeatedly against the same databases.",
                  "pm.collectionVariables.set('runId', Date.now().toString(36));",
                  "pm.collectionVariables.set('username', 'pm_' + pm.collectionVariables.get('runId'));",
                  "pm.collectionVariables.set('ghostPlayerId', 'pm_ghost_' + pm.collectionVariables.get('runId'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Player id and token are returned\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('playerId', json.player_id);",
                  "    pm.collectionVariables.set('jwt', json.jwt);",
                  "    pm.expect(json.jwt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
