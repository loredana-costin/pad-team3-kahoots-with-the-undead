    "name": "Exam Service",
    "description": "Postman Collection for testing Exam Service CRUD endpoints, queries, and validation rules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "id",
      "value": "",
      "type": "string"
    }
