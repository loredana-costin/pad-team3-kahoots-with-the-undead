  "item": [
    {
      "name": "1. Create Exam - Success (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response has generated examId\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"id\");",
              "    pm.collectionVariables.set(\"id\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courseCategory\": \"mathematics\",\n  \"courseName\": \"Software Architecture\",\n  \"passingThreshold\": 60,\n  \"questions\": [\n    {\n      \"id\": \"q1\",\n      \"text\": \"Which of the following is a valid proposition?\",\n      \"options\": [\n        \"2 plus 2\",\n        \"It is raining today\",\n        \"Close the door\",\n        \"Blue\"\n      ],\n      \"correctOptionId\": 1\n    },\n    {\n      \"id\": \"q2\",\n      \"text\": \"What is the cardinality of the power set of a set with 3 elements?\",\n      \"options\": [\n        \"3\",\n        \"6\",\n        \"8\",\n        \"9\"\n      ],\n      \"correctOptionId\": 2\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/exams",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "exams"
          ]
        },
        "description": "Creates a new exam. Automatically saves the returned examId to collection variables."
      },
      "response": []
    },
    {
      "name": "2. Create Exam - Validation Failure (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Response returns validation errors\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"errors\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courseCategory\": \"mathematics\",\n  \"passingThreshold\": 150\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/exams",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "exams"
          ]
        },
        "description": "Tests validation: missing required fields (courseName, questions) and passingThreshold > 100."
      },
      "response": []
    },
    {
      "name": "3. Get All Exams (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/exams",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "exams"
          ]
        },
        "description": "Retrieves the list of all created exams."
      },
      "response": []
