    {
      "name": "4. Filter Exams by Course Category (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Filtered results match category\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "    jsonData.forEach(exam => {",
              "        pm.expect(exam.courseCategory).to.eql(\"mathematics\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/exams?courseCategory=mathematics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "exams"
          ],
          "query": [
            {
              "key": "courseCategory",
              "value": "mathematics"
            }
          ]
        },
        "description": "Filters exams by courseCategory query parameter."
      },
      "response": []
    },
    {
