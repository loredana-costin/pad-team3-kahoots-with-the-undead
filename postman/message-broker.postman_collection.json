        {
          "name": "4.3 Algorithmic Verification: Load Balancer (Round-Robin & Load-Aware)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Verifies the exact Round-Robin and Load-Aware algorithm used in app.services.loadBalancer",
                  "const instances = [",
                  "    { instanceId: 'replica-1', host: 'replica-1', loadStatus: 'normal' },",
                  "    { instanceId: 'replica-2', host: 'replica-2', loadStatus: 'normal' },",
                  "    { instanceId: 'replica-3', host: 'replica-3', loadStatus: 'critical' }",
                  "];",
                  "",
                  "let currentIndex = 0;",
                  "function selectRoundRobin(healthy) {",
                  "    const selected = healthy[currentIndex % healthy.length];",
                  "    currentIndex++;",
                  "    return selected.instanceId;",
                  "}",
                  "",
                  "const normalInstances = instances.filter(i => i.loadStatus === 'normal');",
                  "",
                  "pm.test(\"Load Balancer: Turn 1 selects replica-1\", () => {",
                  "    pm.expect(selectRoundRobin(normalInstances)).to.eql('replica-1');",
                  "});",
                  "pm.test(\"Load Balancer: Turn 2 selects replica-2\", () => {",
                  "    pm.expect(selectRoundRobin(normalInstances)).to.eql('replica-2');",
                  "});",
                  "pm.test(\"Load Balancer: Turn 3 wraps around to replica-1\", () => {",
                  "    pm.expect(selectRoundRobin(normalInstances)).to.eql('replica-1');",
                  "});",
                  "pm.test(\"Load-Aware: critical load instances are deprioritized\", () => {",
                  "    pm.expect(normalInstances.map(i => i.instanceId)).to.not.include('replica-3');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{brokerUrl}}/health",
              "host": ["{{brokerUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "4.4 Algorithmic Verification: Circuit Breaker State Transitions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Verifies the 3-state finite state machine in app.services.circuitBreaker",
                  "class CircuitBreakerSimulator {",
                  "    constructor(threshold = 3, resetSeconds = 5) {",
                  "        this.threshold = threshold;",
                  "        this.resetSeconds = resetSeconds;",
                  "        this.state = 'CLOSED';",
                  "        this.failureCount = 0;",
                  "        this.lastFailureTime = 0;",
                  "    }",
                  "    allowRequest(currentTime) {",
                  "        if (this.state === 'OPEN') {",
                  "            if (currentTime - this.lastFailureTime >= this.resetSeconds) {",
                  "                this.state = 'HALF_OPEN';",
                  "                return true;",
                  "            }",
                  "            return false;",
                  "        }",
                  "        return true;",
                  "    }",
                  "    recordFailure(currentTime) {",
                  "        this.failureCount++;",
                  "        this.lastFailureTime = currentTime;",
                  "        if (this.failureCount >= this.threshold) {",
                  "            this.state = 'OPEN';",
                  "        }",
                  "    }",
                  "    recordSuccess() {",
                  "        this.failureCount = 0;",
                  "        this.state = 'CLOSED';",
                  "    }",
                  "}",
                  "",
                  "const cb = new CircuitBreakerSimulator(3, 5);",
                  "let clock = 1000;",
                  "",
                  "pm.test(\"Circuit Breaker initially starts CLOSED and allows requests\", () => {",
                  "    pm.expect(cb.state).to.eql('CLOSED');",
                  "    pm.expect(cb.allowRequest(clock)).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Consecutive failures below threshold remain CLOSED\", () => {",
                  "    cb.recordFailure(clock);",
                  "    pm.expect(cb.state).to.eql('CLOSED');",
                  "    cb.recordFailure(clock);",
                  "    pm.expect(cb.state).to.eql('CLOSED');",
                  "});",
                  "",
                  "pm.test(\"Threshold (3 failures) reached: circuit trips to OPEN\", () => {",
                  "    cb.recordFailure(clock);",
                  "    pm.expect(cb.state).to.eql('OPEN');",
                  "});",
                  "",
                  "pm.test(\"Immediate subsequent requests are rejected when OPEN\", () => {",
                  "    pm.expect(cb.allowRequest(clock + 1)).to.be.false;",
                  "});",
                  "",
                  "pm.test(\"After cooldown window, circuit transitions to HALF_OPEN for trial\", () => {",
                  "    pm.expect(cb.allowRequest(clock + 6)).to.be.true;",
                  "    pm.expect(cb.state).to.eql('HALF_OPEN');",
                  "});",
                  "",
                  "pm.test(\"Successful trial request closes circuit back to CLOSED\", () => {",
                  "    cb.recordSuccess();",
                  "    pm.expect(cb.state).to.eql('CLOSED');",
                  "    pm.expect(cb.failureCount).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{brokerUrl}}/health",
              "host": ["{{brokerUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    }
  ]
