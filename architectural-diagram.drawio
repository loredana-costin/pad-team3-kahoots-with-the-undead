<mxfile host="drawio" type="device"><diagram id="lab5" name="Architecture (lab 5)"><mxGraphModel dx="1840" dy="1720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1660" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Players" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="22" y="500" width="30" height="60" as="geometry"/></mxCell><mxCell id="c3" value="WebSocket :3003-3005 (live game updates)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#b85450;strokeWidth=1.5;fontColor=#b85450;align=left;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="37" y="498" as="sourcePoint"/><mxPoint x="652" y="98" as="targetPoint"/><Array as="points"><mxPoint x="37" y="32"/><mxPoint x="652" y="32"/></Array><mxPoint x="-300" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c4" value="HTTP + JWT" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#3a5fcd;strokeWidth=1.5;fontColor=#3a5fcd;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="545" as="sourcePoint"/><mxPoint x="138" y="545" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c5" value="&lt;b style='font-size:19px'&gt;API Gateway&lt;/b&gt; (:8000)&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;• Validates JWT (player and service tokens). Verified tokens are &lt;b&gt;cached in Redis&lt;/b&gt;, sharded with consistent hashing (&lt;i&gt;X-Auth-Cache&lt;/i&gt;)&lt;br&gt;&lt;br&gt;• Finds the service that owns the route&lt;br&gt;&lt;br&gt;• Sends &lt;b&gt;every request&lt;/b&gt; to that service's queue in the &lt;b&gt;Message Broker&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Two-Phase Commit coordinator&lt;/b&gt; for curing an Infected Zombie and a Tourist Zombie's steal: prepare / commit / abort on Zombie and Resource Service's &lt;i&gt;/api/tx&lt;/i&gt;, through their broker queues (COORDINATION_MODE=2pc)&lt;br&gt;&lt;br&gt;• With COORDINATION_MODE=saga it starts the broker's &lt;b&gt;cure-zombie&lt;/b&gt; / &lt;b&gt;steal-resources&lt;/b&gt; saga instead and answers 202 + &lt;i&gt;/api/sagas/{id}&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Transaction log in &lt;b&gt;Gateway DB&lt;/b&gt; (written before every step)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=14;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="138" y="95" width="247" height="770" as="geometry"/></mxCell><mxCell id="c6" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="182" y="918" width="150" height="58" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="176" y="924" width="150" height="58" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Gateway DB&lt;/b&gt; ×3&lt;br&gt;&lt;font style='font-size:10px'&gt;2PC transaction log&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="170" y="930" width="150" height="58" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;rounded=0;strokeColor=#6c8ebf;endSize=5;startSize=5;lab