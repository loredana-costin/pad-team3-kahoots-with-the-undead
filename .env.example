# Optional. The stack starts without a .env file: base-db, crafting-db and resource-db fall back to
# postgres/postgres, like the other team databases. Copy this file to .env only if you want
# different credentials on your machine. .env is git-ignored and must never be committed.

# Base Service database (base-db)
BASE_DB_USER=
BASE_DB_PASSWORD=

# Crafting Service database (crafting-db)
CRAFTING_DB_USER=
CRAFTING_DB_PASSWORD=

# Resource Service database (resource-db)
RESOURCE_DB_USER=
RESOURCE_DB_PASSWORD=

# Service Discovery health alerts (optional). Each channel is on when its values are set.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook, copy the URL
ALERT_DISCORD_WEBHOOK_URL=
# Telegram: bot token from @BotFather and the chat id the bot writes to
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
