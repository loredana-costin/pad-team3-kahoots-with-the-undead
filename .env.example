# Optional. The stack starts without a .env file: base-db and crafting-db fall back to
# postgres/postgres, like the other team databases. Copy this file to .env only if you want
# different credentials on your machine. .env is git-ignored and must never be committed.

# Base Service database (base-db)
BASE_DB_USER=
BASE_DB_PASSWORD=

# Crafting Service database (crafting-db)
CRAFTING_DB_USER=
CRAFTING_DB_PASSWORD=
