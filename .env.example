# Optional. The stack starts without a .env file: base-db-1..3, crafting-db-1..3 and resource-db-1..3 fall back to
# postgres/postgres, like the other team databases. Copy this file to .env only if you want
# different credentials on your machine. .env is git-ignored and must never be committed.

# Base Service database (base-db-1..3)
BASE_DB_USER=
BASE_DB_PASSWORD=

# Crafting Service database (crafting-db-1..3)
CRAFTING_DB_USER=
CRAFTING_DB_PASSWORD=

# Base and Crafting Service: how an action that spends resources is coordinated, 2pc (empty = 2pc) or saga
BASE_COORDINATION_MODE=
CRAFTING_COORDINATION_MODE=

# Resource Service database (resource-db-1..3)
RESOURCE_DB_USER=
RESOURCE_DB_PASSWORD=

# Service Discovery health alerts (optional). Each channel is on when its values are set.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook, copy the URL
ALERT_DISCORD_WEBHOOK_URL=
# Telegram: bot token from @BotFather and the chat id the bot writes to
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Message Broker: key for GET http://localhost:8600/logs/download (X-Admin-Key), at least 16 characters.
# The download is off while it is empty.
LOGS_ADMIN_KEY=

# Grafana (http://localhost:3000) admin password; the user is admin. Defaults to admin.
GRAFANA_ADMIN_PASSWORD=

# Shared sharded Redis cache (redis-cache-1, redis-cache-2, redis-cache-3).
# Change REDIS_PASSWORD to a strong secret before running in your environment (never commit a real password).
REDIS_PASSWORD=change-me-redis-password
REDIS_MAXMEMORY=64mb
REDIS_VNODES=160
# CACHE_DEBUG_HEADERS is only for demonstrations (exposes cache hit/miss and shard node headers on responses).
CACHE_DEBUG_HEADERS=false
